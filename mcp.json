{
  "mcpServers": {
    "camofox-browser": {
      "command": "npx",
      "args": ["-y", "@askjo/camofox-browser-mcp"],
      "env": {
        "CAMOFOX_BASE_URL": "${env:CAMOFOX_BASE_URL}",
        "CAMOFOX_ACCESS_KEY": "${env:CAMOFOX_ACCESS_KEY}",
        "CAMOFOX_USER_ID": "${env:CAMOFOX_USER_ID}"
      }
    }
  }
}
